{
  "name": "pocket-gift-wallet",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "assets": "node scripts/prepare-assets.mjs",
    "postinstall": "npm run assets",
    "build": "npm run assets && tsc -b && tsc -p tsconfig.sw.json && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "audit:release": "node scripts/check-release.mjs",
    "check": "npm run test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "dexie": "4.4.6",
    "dexie-react-hooks": "4.4.0",
    "lucide-react": "1.45.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tesseract.js": "7.0.0",
    "zxing-wasm": "3.1.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "fake-indexeddb": "6.2.5",
    "prettier": "3.9.6",
    "sharp": "0.35.4",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.0",
    "workbox-core": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1"
  }
}
